# Copie este arquivo para .env e preencha com os dados do RDS
#   cp .env.example .env

# Porta em que a aplicação roda
PORT=3000

# Banco PostgreSQL no AWS RDS
DB_HOST=seu-banco.xxxxxxxxxxxx.sa-east-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua-senha-aqui
DB_NAME=postgres
DB_SSL=true
